PORT=3000
HOST=0.0.0.0
LM_STUDIO_URL=http://127.0.0.1:1234
# Optional override when LM Studio stores models outside ~/.lmstudio/models
# LM_STUDIO_MODELS_DIR=C:\Users\you\.lmstudio\models
OLLAMA_URL=http://127.0.0.1:11434
APP_NAME=Escarlet Local AI UI
NODE_ENV=production
# Optional: comma-separated origins for local development. Leave empty in production for same-origin use.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Server-side conversation storage. The data directory is created on first use.
DATA_DIR=./data

# Optional simple password protection. Keep disabled for the single-user MVP.
AUTH_ENABLED=false
AUTH_PASSWORD=change-this-password

# Optional remote update and manual restart controls. The UI can check, install, and restart only when enabled.
# UPDATE_ENABLED=true
# UPDATE_TOKEN=replace-with-a-long-random-update-token
UPDATE_ENABLED=false
UPDATE_TOKEN=
UPDATE_BRANCH=master

# Optional OpenCode bridge. Keep disabled unless OpenCode should reach the providers through this server.
# When enabled, a dedicated bearer token is mandatory.
OPENCODE_BRIDGE_ENABLED=false
OPENCODE_BRIDGE_TOKEN=
